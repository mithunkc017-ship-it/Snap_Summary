
{
  "manifest_version": 3,
  "name": "SnapSummary AI",
  "version": "1.0.0",
  "description": "Summarize webpages using your personal AI assistant.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnapSummary AI"
  }
}
